{
 "about": "Canonical PO key test vectors (v2 rule). Every implementation must return exactly these. All values are synthetic.",
 "rule": [
  "1. s = str(raw); null/None -> ''. Replace every run of whitespace, U+00A0 and U+FEFF with one space; trim spaces; upper-case.",
  "2. s == ''  -> key '', kind 'blank'.",
  "3. s matches ^[0-9](\\.[0-9]+)?E\\+[0-9]{1,3}$  -> key '', kind 'mangled' (Excel scientific notation; the real number is lost).",
  "4. s matches ^[0-9]+$  -> key = s without leading zeros ('0' if nothing is left), kind 'num'.",
  "5. s has no digit at all  -> key '~' + s, kind 'name' (a program name used as a PO number).",
  "6. otherwise  -> key = s unchanged (dashes, slashes, letters and leading zeros kept), kind 'code'."
 ],
 "join_key": "CUSTOMER_CODE.strip().upper() + '|' + key, only when kind is 'num' or 'code'. blank, mangled and name never join across stores.",
